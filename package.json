{
  "name": "petwhale",
  "version": "0.0.1",
  "private": true,
  "description": "Visual companions for AI agents — a pluggable visual companion framework (PetWhale)",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "lint": "eslint .",
    "playground": "pnpm --filter @petwhale/playground dev",
    "playground:build": "pnpm --filter @petwhale/playground build",
    "pet": "pnpm --filter @petwhale/pet-window start",
    "pet:build": "pnpm --filter @petwhale/pet-window build",
    "pet:package:mac": "pnpm --filter @petwhale/pet-window package:mac",
    "pet:package:win": "pnpm --filter @petwhale/pet-window package:win",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
