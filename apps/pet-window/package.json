{
  "name": "@petwhale/pet-window",
  "version": "0.0.1",
  "private": true,
  "description": "PetWhale desktop pet window — always-on-top transparent companion fed by the DSH host event stream",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json && vite build",
    "start": "electron .",
    "package": "pnpm package:win",
    "package:win": "pnpm build && electron-packager . PetWhale --platform=win32 --arch=x64 --out=release --overwrite --asar --prune=false \"--ignore=^/src$\"",
    "package:mac": "pnpm build && electron-packager . PetWhale --platform=darwin --arch=universal --out=release --overwrite --asar --prune=false --app-bundle-id=com.petwhale.desktop \"--ignore=^/src$\" && codesign --force --deep --sign - --timestamp=none release/PetWhale-darwin-universal/PetWhale.app",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@petwhale/core": "workspace:*",
    "@petwhale/renderer-orb": "workspace:*",
    "@petwhale/renderer-sprite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-packager": "^17.1.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
