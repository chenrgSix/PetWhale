{
  "name": "@petwhale/renderer-live2d",
  "version": "0.0.1",
  "description": "PetWhale Live2D Cubism renderer with agent-state motion mapping",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "untitled-pixi-live2d-engine": "^1.3.5"
  },
  "devDependencies": {
    "@petwhale/core": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
