{
  "name": "@petwhale/core",
  "version": "0.0.1",
  "description": "PetWhale companion runtime core — host-agnostic, renderer-agnostic semantic layer (TypeScript only, no DOM, no host deps)",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
