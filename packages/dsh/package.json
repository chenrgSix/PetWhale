{
  "name": "@petwhale/dsh",
  "version": "0.0.1",
  "description": "PetWhale client plugin for DeepSeek Harness / Telos — shell.overlay companion entry",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/client/index.d.mts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@petwhale/core": ">=0.0.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "devDependencies": {
    "@petwhale/core": "workspace:*",
    "@petwhale/renderer-orb": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
